rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'davidthedums@gmail.com' && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Entity Validation: Quote Inquiry
    function isValidQuote(data) {
      return data.keys().hasAll(['category', 'quantity', 'clientName', 'clientEmail', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'category', 'quantity', 'finish', 'turnaround', 'clientName', 'clientEmail', 'clientPhone', 'notes', 'status', 'createdAt', 'userId']) &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
        data.quantity is number && data.quantity > 0 && data.quantity <= 1000000 &&
        data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 100 &&
        data.clientEmail is string && data.clientEmail.size() > 0 && data.clientEmail.size() <= 150 &&
        data.status is string && (data.status == 'pending' || data.status == 'reviewed' || data.status == 'in_production' || data.status == 'completed') &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
        (!('clientPhone' in data) || (data.clientPhone is string && data.clientPhone.size() <= 50)) &&
        (!('finish' in data) || (data.finish is string && data.finish.size() <= 100)) &&
        (!('turnaround' in data) || (data.turnaround is string && data.turnaround.size() <= 100)) &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    // Entity Validation: User Profile
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'createdAt']) &&
        data.keys().hasOnly(['id', 'email', 'displayName', 'role', 'createdAt']) &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        data.role is string && (data.role == 'client' || data.role == 'admin') &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50;
    }

    // Quotes Collection
    match /quotes/{quoteId} {
      allow get: if isValidId(quoteId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(quoteId) && isValidQuote(incoming()) && incoming().status == 'pending';
      allow update: if isValidId(quoteId) && isAdmin() && isValidQuote(incoming());
      allow delete: if isValidId(quoteId) && isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && request.auth.uid == userId && isValidUser(incoming()) &&
                    (incoming().role == 'client' || isAdmin());
      allow update: if isValidId(userId) && isValidUser(incoming()) &&
                    ((request.auth.uid == userId && incoming().role == existing().role) || isAdmin());
      allow delete: if isValidId(userId) && isAdmin();
    }
  }
}
